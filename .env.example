# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development                 # development | production

# --- Database ---
DATABASE_URL=sqlite:///./ai_digital_safety.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ai_digital_safety

# --- Privacy ---
STORE_ANALYSIS=false                # true only if you intend to keep anonymized research data

# --- Security ---
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_BYTES=20000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_ENABLED=false
API_KEY=

# --- Threat Intelligence (all optional — system works with all disabled) ---
THREAT_INTEL_ENABLED=true           # master switch for URL analysis threat-intel calls
URLHAUS_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_ENABLED=false
PHISHTANK_API_KEY=
